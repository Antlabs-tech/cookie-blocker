# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
# Required scopes: public_repo
GITHUB_TOKEN=your_token_here

# Optional: min milliseconds between GitHub Search API calls (~30/min cap). Default 2100.
# GITHUB_SEARCH_MIN_INTERVAL_MS=2100

# Optional: add jitter to search pacing (ms). Default 750.
# GITHUB_SEARCH_JITTER_MS=750

# Optional: extra cooldown when Search returns 403 without Retry-After (ms). Default 30000.
# GITHUB_SEARCH_403_COOLDOWN_MS=30000
